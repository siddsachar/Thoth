      },
      "maxItems": 32,
      "title": "Presentation Features",
      "type": "array"
    },
    "protocol_major": {
      "default": 1,
      "maximum": 65535,
      "minimum": 0,
      "title": "Protocol Major",
      "type": "integer"
    }
