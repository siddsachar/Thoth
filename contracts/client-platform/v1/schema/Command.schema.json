{
  "$defs": {
    "ApprovalPayload": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "approve",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "nonce": {
          "maxLength": 256,
          "minLength": 32,
          "title": "Nonce",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "nonce"
      ],
      "title": "ApprovalPayload",
      "type": "object"
    },
    "ApprovalResolveCommand": {
      "additionalProperties": false,
      "properties": {
        "client_session_id": {
          "format": "uuid",
          "title": "Client Session Id",
          "type": "string"
        },
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "expected_revision": {
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "title": "Expected Revision",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ApprovalPayload"
        },
        "type": {
          "const": "approval.resolve",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "client_session_id",
        "expected_revision",
        "type",
        "payload"
      ],
      "title": "ApprovalResolveCommand",
      "type": "object"
    },
    "BindPayload": {
      "additionalProperties": false,
      "properties": {
        "expected_resource_revision": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Resource Revision"
        },
        "kind": {
          "enum": [
            "workspace",
            "artifact"
          ],
          "title": "Kind",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "title": "Resource Id",
          "type": "string"
        },
        "role": {
          "default": "context",
          "enum": [
            "context",
            "primary",
            "reference",
            "output"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "resource_id"
      ],
      "title": "BindPayload",
      "type": "object"
    },
